# =============================================================================
# MoneyFlow — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` está no .gitignore e NUNCA deve ser commitado.
# =============================================================================

# Chave usada para assinar os cookies de sessão.
# Sem ela, qualquer pessoa consegue forjar uma sessão e entrar como outro
# usuário. Gere uma chave nova para cada ambiente com:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Modo de depuração. Em produção deve ser 0 ou ficar de fora:
# com DEBUG=1 o Flask expõe um console Python interativo na web.
DEBUG=0

# Banco de dados.
# Se ficar vazio, usa SQLite local (./moneyflow.db) — bom para desenvolvimento.
# Em produção use PostgreSQL: o disco dos provedores de nuvem é efêmero e o
# arquivo SQLite é apagado a cada deploy.
# DATABASE_URL=postgresql://usuario:senha@host:5432/moneyflow

# Rede
HOST=0.0.0.0
PORT=8050

# Sessão
SESSION_LIFETIME_DAYS=7
# Exige HTTPS para enviar o cookie de sessão. Deixe 1 em produção.
SESSION_COOKIE_SECURE=1

# Custo do bcrypt. Maior = mais seguro e mais lento. 12 é o padrão atual.
BCRYPT_ROUNDS=12
